# From https://discord.com/developers/applications -> your app
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Set to your test server's id while developing: commands update instantly there.
# Leave empty to deploy globally (can take up to an hour to show up).
DISCORD_GUILD_ID=

# The skystats server's public API
SKYSTATS_API_URL=http://localhost:3000
LOG_LEVEL=info

# Website for "View on SkyStats" buttons
SKYSTATS_WEB_URL=https://skystats.cc
# Channel ids that get free Hypixel outage alerts (comma-separated)
STATUS_ALERT_CHANNEL_IDS=
